# Git ignore
# Release files
machinon-*.zip
machinon-*.tar.gz
# Shell files except the one for making releases
*.sh
!makerelease.sh
!scripts/check-typography.sh
!scripts/check-buttons.sh
!scripts/check-shadows.sh
!scripts/check-menus.sh
!scripts/build-dist.sh
# JPEG images
images/*.[jJ][pP][gG]
# Claude-generated working documents (local-only: specs, plans, brainstorms)
docs/superpowers/
.superpowers/
# Release build output (generated by scripts/build-dist.sh, not source)
dist/
