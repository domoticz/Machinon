# Git ignore
# Release files
machinon-*.zip
machinon-*.tar.gz
# Shell files except the repo's own scripts/
*.sh
!scripts/check-typography.sh
!scripts/check-buttons.sh
!scripts/check-shadows.sh
!scripts/check-menus.sh
!scripts/build-dist.sh
!scripts/check-comments-only.sh
!scripts/check-tokens.sh
!scripts/build-release.sh
# JPEG images
images/*.[jJ][pP][gG]
# Claude-generated working documents (local-only: specs, plans, brainstorms)
docs/superpowers/
.superpowers/
# Release build output (generated by scripts/build-dist.sh, not source)
dist/
# Python cache
__pycache__/
# Local-only working files: never commit these (kept untracked today; these
# entries make that permanent)
CLAUDE.md
todo.md
.claude/
